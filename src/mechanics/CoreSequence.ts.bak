import * as THREE from "three";
import type { Game } from "../core/Game";
import { easeInOutCubic, easeOutCubic } from "../effects/Tween";
import { ArmorSystem } from "../combat/ArmorSystem";
import { EnergySword } from "../combat/EnergySword";

/**
 * Stage 5 finale timeline — now with full NEXUS Awakening cinematic.
 *
 * Timeline:
 *  0.0 – 2.0s  : Energy streams from hero into the Core
 *  2.0s        : Core ignition
 *  2.5 – 5.5s  : Armor materializes piece by piece on the hero
 *  5.5 – 7.0s  : Energy sword forms in hero's hand
 *  7.0 – 9.5s  : Camera sweeps to show the awakened hero
 *  9.5s        : onComplete() is called ? robots emerge
 */
export class CoreSequence {
  private time = 0;
  private done = false;
  private readonly coreCenter = new THREE.Vector3();
  private readonly cameraPos = new THREE.Vector3();
  private readonly lookAt = new THREE.Vector3();
  private readonly scratch = new THREE.Vector3();
  private coreMaterial: THREE.MeshStandardMaterial | null = null;
  private ringMaterial: THREE.MeshStandardMaterial | null = null;
  private coreOrb: THREE.Object3D | null = null;
  private wavesFired = 0;
  private ignited = false;
  private readonly fired = new Set<string>();
  private skipped = false;

  // Awakening equipment
  private armor: ArmorSystem | null = null;
  private sword: EnergySword | null = null;
  private armorStarted = false;
  private swordStarted = false;

  // Story captions
  private readonly story: Array<{ time: number; text: string }> = [
    { time: 0.5, text: "NEXUS CORE: Power transfer initiated." },
    { time: 2.2, text: "NEXUS CORE: You have been chosen, Wanderer." },
    { time: 3.5, text: "Awakening Protocol: ARMOR SYSTEM — ONLINE" },
    { time: 5.8, text: "Awakening Protocol: ENERGY BLADE — ONLINE" },
    { time: 7.5, text: "NEXUS CORE: The legion stirs. They will not rest." },
    { time: 8.5, text: "NEXUS CORE: Rise. Your armor remembers." },
  ];
  private captionIndex = 0;

  constructor(
    private readonly game: Game,
    private readonly onComplete: () => void,
  ) {}

  start(): void {
    const game = this.game;
    const core = game.world.root.getObjectByName("decor-core");
    if (core) {
      this.coreOrb = core.getObjectByName("coreOrb") ?? null;
      const mesh = this.coreOrb as THREE.Mesh | null;
      if (mesh?.material) this.coreMaterial = mesh.material as THREE.MeshStandardMaterial;
      const ring = core.getObjectByName("coreRing0") as THREE.Mesh | null;
      if (ring?.material) this.ringMaterial = ring.material as THREE.MeshStandardMaterial;
      this.coreOrb?.getWorldPosition(this.coreCenter);
    } else {
      this.coreCenter.copy(game.player.position).add(new THREE.Vector3(0, 8, -14));
    }

    this.lookAt.copy(this.coreCenter);
    this.cameraPos.copy(game.player.position).add(new THREE.Vector3(10, 2, 22));
    game.cameraController.cinematicTarget = this.lookAt;
    game.cameraController.cinematicPosition = this.cameraPos;
    game.player.controller.facing
      .subVectors(this.coreCenter, game.player.position)
      .setY(0)
      .normalize();
    game.audio.setMusicIntensity(0.95);

    // Build armor and sword if player has a loaded rig
    const rig = game.player.model.character;
    if (rig) {
      this.armor = new ArmorSystem(rig);
      this.sword = new EnergySword(rig);
    }

    // Show skip hint after 1 second
    setTimeout(() => {
      game.bus.emit("combat:tutorial", { step: "skip-hint" });
    }, 1000);
  }

  /** Can be called by pressing Space or E during the cinematic. */
  skip(): void {
    if (this.skipped || this.time < 1.0) return;
    this.skipped = true;
    this.armor?.snapVisible();
    this.sword?.snapVisible();
    if (this.armor && this.sword) {
      this.game.combat?.setAwakened(this.armor, this.sword);
    }
    this._finishCinematic();
  }

  update(delta: number): void {
    if (this.done) return;
    const game = this.game;

    // Allow skip after 1s
    if (this.time > 1.0 && game.input.keyboard.isDown("KeyE")) {
      this.skip();
      return;
    }

    this.time += delta;
    const t = this.time;

    // Update armor/sword if created
    this.armor?.update(delta);
    this.sword?.update(delta);

    // — Story captions
    while (this.captionIndex < this.story.length && t >= this.story[this.captionIndex].time) {
      showCaption(this.story[this.captionIndex].text);
      this.captionIndex++;
    }

    // 0.0 – 2.0s: energy streams from the player into the Core
    if (t > 0.4 && t < 2.0 && Math.floor(t * 30) % 2 === 0) {
      this.scratch.subVectors(this.coreCenter, game.player.position).normalize();
      game.particles.burst({
        position: game.player.position.clone(),
        count: 6, color: 0x19e6ff, speed: 14, spread: 0.15,
        direction: this.scratch, life: 0.9, size: 0.22, drag: 0.2,
      });
    }

    // 2.0s: ignition
    if (t >= 2.0 && !this.ignited) {
      this.ignited = true;
      game.bus.emit("core:ignite", { position: this.coreCenter });
      game.cameraController.addTrauma(0.6);
      game.cameraController.punchFov(8);
      game.particles.burst({ position: this.coreCenter.clone(), count: 220, color: 0xdff6ff, speed: 10, life: 1.6, size: 0.3, drag: 1.2 });
      game.tweens.tween(1.2, (k) => game.scene.post.setFlash(0.9 * (1 - k), 0xdff6ff), easeOutCubic);
    }

    // 2.5s: start armor materialization
    if (t >= 2.5 && !this.armorStarted) {
      this.armorStarted = true;
      game.bus.emit("awakening:armor", undefined);
      this.armor?.materialize(3.0);
      // Energy flows back FROM Core into player
      game.tweens.tween(3.0, (k) => {
        this.scratch.subVectors(game.player.position, this.coreCenter).normalize();
        if (Math.floor(k * 60) % 3 === 0) {
          game.particles.burst({
            position: this.coreCenter.clone(), count: 4, color: 0x19e6ff, speed: 12,
            spread: 0.2, direction: this.scratch.clone(), life: 0.6, size: 0.2, drag: 0.3,
          });
        }
      });
    }

    // 5.5s: materialize sword
    if (t >= 5.5 && !this.swordStarted) {
      this.swordStarted = true;
      game.bus.emit("awakening:sword", undefined);
      this.sword?.materialize(1.5);
      game.particles.burst({
        position: game.player.position.clone().add(new THREE.Vector3(0, 1.2, 0)),
        count: 40, color: 0x8a5cff, speed: 5, spread: 2.0, life: 0.7, size: 0.16,
      });
    }

    // Power ramps 0 ? 1 between 2.0s and 7s
    const power = THREE.MathUtils.clamp((t - 2.0) / 5.0, 0, 1);
    game.environment.setPower(easeInOutCubic(power));
    if (this.coreMaterial) this.coreMaterial.emissiveIntensity = 0.6 + power * 2.6 + (this.ignited ? Math.sin(t * 6) * 0.4 : 0);
    if (this.ringMaterial) this.ringMaterial.emissiveIntensity = 0.45 + power * 1.4;
    if (this.coreOrb) {
      const sc = 1 + power * 0.6 + (this.ignited ? Math.sin(t * 4) * 0.04 : 0);
      this.coreOrb.scale.setScalar(sc);
      this.coreOrb.rotation.y += delta * (0.4 + power * 2);
    }

    // Illumination waves every 0.7s after ignition
    if (this.ignited && t > 2.4 + this.wavesFired * 0.7 && this.wavesFired < 6) {
      this.wavesFired++;
      game.bus.emit("core:wave", { index: this.wavesFired });
      const radius = 4 + this.wavesFired * 6;
      for (let i = 0; i < 24; i++) {
        const a = (i / 24) * Math.PI * 2;
        this.scratch.set(
          this.coreCenter.x + Math.cos(a) * radius,
          this.coreCenter.y - 2 + Math.sin(i) * 2,
          this.coreCenter.z + Math.sin(a) * radius,
        );
        game.particles.burst({ position: this.scratch.clone(), count: 3, color: 0x19e6ff, speed: 2, life: 1.2, size: 0.25, drag: 1 });
      }
      game.cameraController.addTrauma(0.15);
    }

    // Camera pull-back — shifts to frame the hero at 7s
    const pull = easeInOutCubic(THREE.MathUtils.clamp(t / 9.5, 0, 1));
    if (t < 7) {
      // Look at Core
      this.cameraPos.set(
        this.coreCenter.x + 10 + pull * 20,
        this.coreCenter.y - 10 + pull * 18,
        this.coreCenter.z + 34 + pull * 30,
      );
      this.lookAt.copy(this.coreCenter).setY(this.coreCenter.y + pull * 4);
    } else {
      // Swing to hero reveal
      const heroT = THREE.MathUtils.clamp((t - 7) / 2.5, 0, 1);
      this.cameraPos.lerpVectors(
        this.cameraPos,
        game.player.position.clone().add(new THREE.Vector3(4, 2.5, 8)),
        heroT * delta * 2,
      );
      this.lookAt.lerpVectors(
        this.lookAt,
        game.player.position.clone().add(new THREE.Vector3(0, 1.5, 0)),
        heroT * delta * 2,
      );
    }

    if (t > 7 && !this.fired.has("climax")) {
      this.fired.add("climax");
      game.audio.setMusicIntensity(1);
      game.bus.emit("awakening:complete", undefined);
      if (this.armor && this.sword) {
        game.combat?.setAwakened(this.armor, this.sword);
      }
    }

    if (t >= 9.5) {
      this._finishCinematic();
    }
  }

  private _finishCinematic(): void {
    this.done = true;
    this.onComplete();
  }

  dispose(): void {
    this.done = true;
    this.game.cameraController.cinematicTarget = null;
    this.game.cameraController.cinematicPosition = null;
  }
}

function showCaption(text: string): void {
  // Create or update the cinematic caption DOM element
  let el = document.getElementById("nexus-cinematic-caption") as HTMLElement | null;
  if (!el) {
    el = document.createElement("div");
    el.id = "nexus-cinematic-caption";
    el.style.cssText = [
      "position:fixed", "bottom:15%", "left:50%", "transform:translateX(-50%)",
      "color:#19e6ff", "font-family:Orbitron,monospace", "font-size:clamp(14px,2vw,20px)",
      "text-align:center", "pointer-events:none", "z-index:900",
      "text-shadow:0 0 12px #19e6ff,0 0 24px #19e6ff80",
      "letter-spacing:0.12em", "max-width:90vw",
      "transition:opacity 0.4s",
    ].join(";");
    document.body.appendChild(el);
  }
  el.textContent = text;
  el.style.opacity = "1";
  clearTimeout((el as HTMLElement & { _timer?: ReturnType<typeof setTimeout> })._timer);
  (el as HTMLElement & { _timer?: ReturnType<typeof setTimeout> })._timer = setTimeout(() => {
    if (el) el.style.opacity = "0";
  }, 2600);
}
